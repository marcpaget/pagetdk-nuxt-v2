{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt build --pwa",
    "dev:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "generate:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt generate --pwa",
    "preview:pwa": "nuxt preview --pwa",
    "pwa:build": "npm run generate:pwa && npm run preview:pwa",
    "pwa:dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "prepare": "husky",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:nuxt": "vitest run --project nuxt --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests"
  },
  "lint-staged": {
    "**/*": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/noto": "^1.2.7",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/devtools": "latest",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/leaflet": "^1.3.2",
    "@nuxtjs/supabase": "^2.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/nuxt": "^14.2.1",
    "git-format-staged": "^4.0.1",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mapbox-gl": "^3.20.0",
    "nuxt-api-party": "^3.4.2",
    "nuxt-mapbox": "^1.6.4",
    "nuxt-particles": "^0.3.0",
    "nuxt-umami": "^3.2.1",
    "playwright-core": "^1.58.2",
    "typescript": "^5.9.3",
    "usemods-nuxt": "^1.16.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@capacitor/app": "8.0.1",
    "@capacitor/cli": "8.2.0",
    "@capacitor/core": "8.2.0",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/status-bar": "8.0.1",
    "@compodium/nuxt": "^0.1.0-beta.12",
    "@nuxt/content": "3.12.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "^1.0.0",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/scripts": "^0.13.2",
    "@nuxtjs/mdc": "0.20.2",
    "@sentry/nuxt": "^10.43.0",
    "@tailwindcss/vite": "^4.2.1",
    "@unhead/vue": "^2.1.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/compiler-sfc": "^3.5.30",
    "better-sqlite3": "^12.8.0",
    "daisyui": "^5.5.19",
    "nuxt": "^4.4.2",
    "nuxt-booster": "^3.3.2",
    "nuxt-maplibre": "^1.2.2",
    "nuxt-studio": "^1.4.0",
    "nuxt-toc": "^2.7.2",
    "tailwindcss": "^4.2.1",
    "valibot": "^1.2.0",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-router": "latest",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@vercel/nft": "^0.27.4"
  }
}
