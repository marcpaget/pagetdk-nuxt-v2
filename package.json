{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:studio": "drizzle-kit studio",
    "build:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt build --pwa",
    "dev:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "generate:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt generate --pwa",
    "preview:pwa": "nuxt preview --pwa",
    "pwa:build": "npm run generate:pwa && npm run preview:pwa",
    "pwa:dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "prepare": "[ \"$VERCEL\" = \"1\" ] || [ \"$CI\" = \"true\" ] || husky",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "nuxt typecheck",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,jsonc}": [
      "biome check --write"
    ]
  },
  "lint-staged-ignore": {
    "**/*": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/noto": "^1.2.9",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/devtools": "3.4.3",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/leaflet": "^1.3.3",
    "@nuxtjs/supabase": "^2.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.5",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "git-format-staged": "^4.0.2",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt-api-party": "^4.0.1",
    "nuxt-particles": "^0.3.0",
    "nuxt-umami": "^3.2.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@compodium/nuxt": "^0.1.0-beta.14",
    "@nuxt/content": "^3.16.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/kit": "^4.6.0",
    "@nuxtjs/mdc": "0.23.2",
    "@nuxtjs/partytown": "^2.0.0",
    "@nuxtjs/plausible": "^4.0.0",
    "@sentry/nuxt": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/y-tiptap": "^3.0.10",
    "@unhead/vue": "^3.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/compiler-sfc": "^3.5.44",
    "better-sqlite3": "^13.0.3",
    "daisyui": "^5.7.50",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^1.0.0-rc.4",
    "nuxt": "^4.6.0",
    "nuxt-studio": "^1.7.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "web-haptics": "^0.0.6",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@vercel/nft": "^0.27.4",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true,
    "@sentry/cli@2.58.5": true,
    "@tsparticles/engine@3.9.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
