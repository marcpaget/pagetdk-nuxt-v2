{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:studio": "drizzle-kit studio",
    "build:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt build --pwa",
    "dev:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "generate:pwa": "NODE_OPTIONS='--max-old-space-size=6144' nuxt generate --pwa",
    "preview:pwa": "nuxt preview --pwa",
    "pwa:build": "npm run generate:pwa && npm run preview:pwa",
    "pwa:dev": "NODE_OPTIONS='--max-old-space-size=6144' nuxt dev --pwa",
    "prepare": "[ \"$VERCEL\" = \"1\" ] || [ \"$CI\" = \"true\" ] || husky",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "nuxt typecheck",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,jsonc}": [
      "biome check --write"
    ]
  },
  "lint-staged-ignore": {
    "**/*": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/noto": "^1.2.7",
    "@iconify-json/simple-icons": "^1.2.89",
    "@nuxt/devtools": "latest",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "@nuxtjs/supabase": "^2.0.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/nuxt": "^14.3.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "git-format-staged": "^4.0.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "mapbox-gl": "^3.26.0",
    "nuxt-api-party": "^3.4.2",
    "nuxt-mapbox": "^1.6.4",
    "nuxt-particles": "^0.3.0",
    "nuxt-umami": "^3.2.1",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "usemods-nuxt": "^1.16.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/cli": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.2",
    "@compodium/nuxt": "^0.1.0-beta.12",
    "@nuxt/content": "^3.15.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "^1.1.3",
    "@nuxt/kit": "^4.4.8",
    "@nuxtjs/mdc": "0.22.1",
    "@nuxtjs/partytown": "^2.0.0",
    "@nuxtjs/plausible": "^3.0.2",
    "@sentry/nuxt": "^10.65.0",
    "@tailwindcss/vite": "^4.3.2",
    "@unhead/vue": "^3.1.7",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/compiler-sfc": "^3.5.39",
    "better-sqlite3": "^12.11.1",
    "daisyui": "^5.6.17",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "nuxt": "^4.4.8",
    "nuxt-booster": "^3.3.2",
    "nuxt-maplibre": "^1.2.2",
    "nuxt-studio": "^1.7.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.2",
    "valibot": "^1.4.2",
    "vite": "^8.1.4",
    "vue": "^3.5.39",
    "web-haptics": "^0.0.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@vercel/nft": "^0.27.4",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true,
    "@sentry/cli@2.58.5": true,
    "@tsparticles/engine@3.9.1": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
